#:kivy 1.11.1

<MainWidget>:
    orientation: 'vertical'
    canvas:
        Color:
            rgb: 0.5,0.5,0.5
        Rectangle:
            size: self.size
    BoxLayout:
        orientation:'horizontal'
        size_hint: (1,0.1)
        spacing: 10
        Label:
            text: 'Supervisório Bomba Hidraulica'
            size_hint_x: None
            width: 400  #largura do texto
        BoxLayout:
            orientation:'vertical'
            size_hint_x: None
            width: 500  
            Label: 
                text: 'Configurações'
            BoxLayout:
                orientation:'horizontal'
                Button:
                    text: 'MODBUS'
                    on_release: root._modbusPopup.open()
                Button:
                    text: 'Scan Time' #tempo de varredura
                    on_release: root._scanPopup.open()
        Image:
        #imagem de conexao estabelecida
            id: img_con
            size_hint_x: None
            width: 80 #largura em pixels
            source: '../imgs/desconectado.png'
            pos_hint: {'top':1, 'right':1}

    FloatLayout:
    #imagem da simulaçao da bomba
        canvas:
            Color:
                rgba: 1,1,1,0.8
            Rectangle:
                size: self.size

        Image:
            source: '../imgs/bomba.png' #olhar certinho se os nomes batem
        
        Label: #PIT-01(Pressão)
            id: pressao 
            text:'-.-'
            font_size: 15
            bold: True
            halign: 'center'
            pos_hint: {'x':-0.331,'y':0.138} #variam de -0.5 ate 0.5
            color: 0,0,0,1

        Label: #PIT-01(Pressão) Auxiliar
            id: pressao_aux
            text:'Kgf/cm²'
            font_size: 15
            bold: True
            halign: 'center'
            pos_hint: {'x':-0.276,'y':0.138} #variam de -0.5 ate 0.5
            color: 0,0,0,1            

        Label: #FIT-01(Vazão)
            id: vazao 
            text:'-.-'
            font_size: 15
            bold: True
            halign: 'center'
            pos_hint: {'x':-0.032,'y':0.172} #variam de -0.5 ate 0.5
            color: 0,0,0

        Label: #FIT-01(Vazão) Auxiliar
            id: vazao_aux 
            text:'m²/h'
            font_size: 15
            bold: True
            halign: 'center'
            pos_hint: {'x':0.01,'y':0.172} #variam de -0.5 ate 0.5
            color: 0,0,0

        Label: #LIT-01(Nível)
            id: nivel 
            text:'-.-'
            font_size: 15
            bold: True
            halign: 'center'
            pos_hint: {'x':0.384,'y':0.334} #variam de -0.5 ate 0.5
            color: 0,0,0

        Label: #LIT-01(Nível) Auxiliar
            id: nivel_aux
            text:'%'
            font_size: 15
            bold: True
            halign: 'center'
            pos_hint: {'x':0.412,'y':0.334} #variam de -0.5 ate 0.5
            color: 0,0,0
        
        Label: #Nivel dinâmico
            id: lb_nivel
            size_hint:(None,None)
            size: (16,50)
            pos_hint:{'x':0.912,'y':0.698} #posiçao na tela
            canvas:
                Color:
                    rgb: 0,0,1
                Rectangle:
                    size: self.size
                    pos: (self.pos[0]+self.width*1,self.pos[1]) #calcular a posicao central do label

        Label: #Rotação
            id: rot_rpm 
            text:'-.-'
            font_size: 15
            bold: True
            halign: 'center'
            pos_hint: {'x':-0.336,'y':-0.372} #variam de -0.5 ate 0.5
            color: 0,0,0
        Label: #Rotação Auxiliar
            id: rot_rpm_aux
            text: '\nRPM'
            font_size: 15
            bold: True
            halign: 'center'
            pos_hint: {'x':-0.336,'y':-0.382} #variam de -0.5 ate 0.5
            color: 0,0,0
        Label: #Torque
            id: torque 
            text:'-.-'
            font_size: 15
            bold: True
            halign: 'center'
            pos_hint: {'x':-0.436,'y':-0.372} #variam de -0.5 ate 0.5
            color: 0,0,0
        Label: #Torque Auxiliar
            id: torque_aux
            text:'\nN.m'
            font_size: 15
            bold: True
            halign: 'center'
            pos_hint: {'x':-0.436,'y':-0.382} #variam de -0.5 ate 0.5
            color: 0,0,0  

        Label: #Nivel dinâmico Pressao
            id: lb_pressao
            size_hint:(None,None)
            size: (85,20)
            pos_hint:{'x':0.085,'y':0.516} #posiçao na tela
        #     canvas:
        #         Color:
        #             rgb: 1,0,0
        #         Rectangle:
        #             size: self.size
        #             pos: (127,400) #calcular a posicao central do label
        # Image:
        #     id: regua
        #     source: '../imgs/regua.png'
        #     size_hint: 0.17,0.17
        #     pos_hint: lb_pressao.pos_hint

        

        Label: #Nivel dinâmico Vazao
            id: lb_vazao
            size_hint:(None,None)
            size: (85,20)
            pos_hint:{'x':0.386,'y':0.545} #posiçao na tela
            canvas:
                Color:
                    rgb: 1,0,0
                Rectangle:
                    size: self.size
                    pos: (428,420) #calcular a posicao central do label
        Image:
            id: regua
            source: '../imgs/regua.png'
            size_hint: 0.17,0.17
            pos_hint: lb_vazao.pos_hint

        Button:
            size_hint: (None, None)
            text: 'Atuação'
            size: (200, 58)
            pos_hint: {'x': 0.75, 'y': 0}  # 40% da largura e 50% da altura do layout pai
            on_release: root._atuacaoPopup.open()
        
        BoxLayout:
            orientation:'horizontal'
            size_hint: (None, None)
            size:(200,30)
            pos_hint: {'x': 0, 'y': 0.32}
            Button:
                text:'LIGA'
                on_release:
                    root.ligaMotor(app.root._addrPartida)
            Button:
                text:'DESLIGA'
                on_release:
                    root.desligaMotor(app.root._addrPartida)
            Button:
                size_hint: (0.3,1)
                size: 30,30
                on_release: root._atuacaoPopup.open()
                Image:
                    source: '../imgs/engrenagem.png'
                    size_hint: None, None
                    size: 20, 20
                    center_x: self.parent.center_x
                    center_y: self.parent.center_y
        
        Label: #Visor de seleção do motor
            id: visor_part
            text: '-.-'
            font_size: 15
            bold: True
            halign: 'center'
            pos_hint: {'x': -0.385, 'y': -0.2} #variam de -0.5 ate 0.5
            color: 0,0,0,1
        
        BoxAlerta:
            id: alerta_vazao
            pos: (500, 370)
        BoxAlerta:
            id: alerta_pressao
            pos: (200, 350)
        BoxAlerta:
            id: alerta_nivel
            pos: (760, 460)
        BoxAlerta:
            id: alerta_torque
            pos: (40, 100)
        BoxAlerta:
            id: alerta_rot_rpm
            pos: (140, 100)


<BoxAlerta@BoxLayout>:
    size_hint: (None, None)
    size: (15, 15)
    corAlerta: (1, 1, 1, 0.2)  # Defina um valor padrão ou deixe ele ser alterado pelo Python
    canvas:
        Color:
            rgba: root.corAlerta  # A cor será acessada aqui
        Triangle:
            points: [self.pos[0], self.pos[1], self.pos[0] + self.size[0], self.pos[1], self.pos[0] + self.size[0]/2, self.pos[1] + self.size[1]]