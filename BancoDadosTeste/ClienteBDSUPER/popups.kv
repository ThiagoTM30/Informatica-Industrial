#:kivy 1.11.1
<ModbusPopup>:
    title:"Configurações MODBUS"
    size_hint_y: None
    size_hint_x: 0.4
    height:200
    BoxLayout:
        id: layout
        orientation:'vertical'
        GridLayout:
            cols:2
            rows:2
            Label:
                text: "IP"
                font_size: 14
            TextInput:
                id: txt_ip
                text:"127.0.0.1"
                font_size: 14
                halign:'center'
                valign: 'middle'
            Label:
                text: "Porta"
                font_size: 14
            TextInput:
                id: txt_porta
                text:"502"
                font_size: 14
                halign:'center'
                valign: 'middle'
        BoxLayout:
            orientation:'horizontal'
            Button:
                size_hint_y: None
                height: 40
                text: "Conectar"
                on_release:
                    root.clearInfo()
                    app.root.startDataRead(txt_ip.text, int(txt_porta.text))
            Button:
                size_hint_y: None
                height: 40
                text: "Fechar"
                on_release:
                    root.dismiss()
                    root.clearInfo()
<ScanPopup>:
    title:"Configurações ScanTime"
    size_hint_y: None
    size_hint_x: 0.4
    height:150
    BoxLayout:
        id: layout
        orientation:'vertical'
        GridLayout:
            cols:2
            rows:1
            Label:
                text: "ScanTime[ms]"
                font_size: 14
            TextInput:
                id: txt_st
                font_size: 14
                halign:'center'
                valign: 'middle'
        BoxLayout:
            orientation:'horizontal'
            Button:
                size_hint_y: None
                height: 40
                text: "Configurar"
                on_release:
                    app.root._scan_time = int(txt_st.text)
            Button:
                size_hint_y: None
                height: 40
                text: "Fechar"
                on_release:
                    root.dismiss()
<AtuacaoPopup>:
    title: "Atuação e controle na planta"
    size_hint_y: None
    size_hint_x: 1
    height:350
    BoxLayout:
        id: partidas
        orientation: 'vertical'
        BoxLayout:
            orientation:'horizontal'
            size_hint: (1,0.2)
            CheckBox:
                on_active: 
                    app.root._addrPartida = 1319
                group: 'partida_group'
            Label:
                text: "PARTIDA DIRETA"    
            CheckBox:
                on_active: 
                    app.root._addrPartida = 1316
                group: 'partida_group'

            Label:
                text: "SOFT START"
                
            CheckBox:
                on_active: 
                    app.root._addrPartida = 1312
                group: 'partida_group'
            Label:
                text: "INVERSOR"
                

        GridLayout:
            cols:4
            size_hint: (1,0.2)
            Label:
                text: "ACELERAÇÃO"
            TextInput:
                id: acel_st
                font_size: 14
                halign:'center'
                valign: 'middle'    
        
            Label:
                text: "DESACELERAÇÃO"
            TextInput:
                id: desacel_st
                font_size: 14
                halign:'center'
                valign: 'middle'
        BoxLayout:
            orientation:'vertical'
            Label:
                size_hint: (1,1)
                text: 'Frequência (exclusivo do inversor): ' + str(slider_vel.value) + ' Hz'
            Slider:
                id: slider_vel
                min: 0
                max: 60   
                value: 0  # Valor inicial = 0 Hz
                step: 1   # Passo de 1 Hz (opcional, para "travar" em valores inteiros)             
                on_touch_move: 
                    app.root.defineVel(int((slider_vel.value)))  # Usa valor arredondado
                #    root._vel[1] = int((slider_vel.value)) * root._vel[1]/abs(root._vel[1])
        BoxLayout:
            size_hint: (1,0.15)
            canvas:
                Color:
                    rgb: 1,0,0
            Button:
                text: "APLICAR"
                #on_release:
                #    app.root.acionamento()
            Button:              
                text: "FECHAR"
                on_release:
                    root.dismiss()
                
<DataGraphPopup>
    title: root.title
    BoxLayout:
        orientation:'vertical'
        TimeSeriesGraph:
            id: graph
            xlabel: 'Horario'
            ylabel: root.ylabel
            background_color: 0.5,0.5,0.5,0.5
            x_ticks_minor: 1
            x_ticks_major: 5
            y_grid_label: True
            x_grid_label: True
            padding: 5
            x_grid: True
            y_grid: True
            xmin : 0 
            ymin : 0

        BoxLayout:
            orientation:'horizontal'
            size_hint: (1,0.05)
            BoxLayout:
                orientation:'horizontal'
                size_hint: (0.5,1)
                Label:
                    size_hint: (0.3,1)
                    text: "Numero de pontos do grafico"
                LabeledCheckBoxDataGraph:
                    id: mp20
                    graph_reference: root
                    on_kv_post:
                        self.ids.label.text = '20'
                        self.ids.checkbox.group = 'cb_group'
                        self.ids.checkbox.active = True
                LabeledCheckBoxDataGraph:
                    id: mp50
                    graph_reference: root
                    on_kv_post:
                        self.ids.label.text = '50'
                        self.ids.checkbox.group = 'cb_group'
                LabeledCheckBoxDataGraph:
                    id: mp100
                    graph_reference: root
                    on_kv_post:
                        self.ids.label.text = '100'
                        self.ids.checkbox.group = 'cb_group'                
            Button:
                text: "Fechar"
                background_color: 1,0,0,1
                size_hint:(0.1,1)
                on_release: root.dismiss()


<LabeledCheckBoxDataGraph>:
    orientation:'horizontal'
    size_hint: (0.1,1)
    CheckBox:
        id: checkbox
        on_active: 
            root.graph_reference.ids.graph.setMaxPoints(int(label.text),0) if root.graph_reference else None
    Label: 
        id: label      

<HistoricalDataGraphPopup>
    title: "Gráfico de Monitoramento Dados Históricos"
    BoxLayout:
        orientation:'vertical'
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: "40dp"
            padding: "5dp"
            spacing: "5dp"
            Label:
                text: "Variável:"
                size_hint_x: None
                width: "60dp"
            Spinner:
                id: spinner
                text: "Lista de Variaveis"
                values: []
                on_text: root.on_spinner_select(self.text)
            

        TimeSeriesGraph:
            id: graph
            xlabel: 'Horario'
            ylabel: ''
            background_color: 0.5,0.5,0.5,0.5
            x_ticks_minor: 1
            x_ticks_major: 5
            y_grid_label: True
            x_grid_label: True
            padding: 5
            x_grid: True
            y_grid: True
            xmin : 0 
            ymin : 0

        BoxLayout:
            orientation:'horizontal'
            size_hint: (1,0.05)
            BoxLayout:
                orientation:'horizontal'
                size_hint: (0.5,1)
                Label:
                    size_hint: (0.3,1)
                    text: "Numero de pontos do grafico"
                LabeledCheckBoxHistoricalDataGraph:
                    id: mp20
                    on_kv_post:
                        self.ids.label.text = '20'
                        self.ids.checkbox.group = 'cb_group'
                        self.ids.checkbox.active = True
                LabeledCheckBoxHistoricalDataGraph:
                    id: mp50
                    on_kv_post:
                        self.ids.label.text = '50'
                        self.ids.checkbox.group = 'cb_group'
                LabeledCheckBoxHistoricalDataGraph:
                    id: mp100
                    on_kv_post:
                        self.ids.label.text = '100'
                        self.ids.checkbox.group = 'cb_group'                
            Button:
                text: "Fechar"
                background_color: 1,0,0,1
                size_hint:(0.1,1)
                on_release: root.dismiss()


<LabeledCheckBoxHistoricalDataGraph>
    orientation:'horizontal'
    size_hint: (0.1,1)
    CheckBox:
        id: checkbox
        on_active: app.root._graph.ids.graph.setMaxPoints(int(label.text),0) if app.root is not None else None
    Label: 
        id: label 


<QueryHistoricalDataPopup>
    title: "Consulta de Dados Históricos"
    BoxLayout:
        orientation:'vertical'
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: "40dp"
            padding: "5dp"
            spacing: "5dp"
            Label:
                text: "Variável:"
                size_hint_x: None
                width: "60dp"
            Spinner:
                id: spinner
                text: "Lista de Variáveis"
                values: []
                on_text: root.on_spinner_select(self.text)
            Button:
                text: "Buscar"
                size_hint_x: None
                width: "80dp"
                on_release: root.query_data()
        
        TimeSeriesGraph:
            id: graph
            xlabel: 'Horário'
            ylabel: ''
            background_color: 0.5,0.5,0.5,0.5
            x_ticks_minor: 1
            x_ticks_major: 5
            y_grid_label: True
            x_grid_label: True
            padding: 5
            x_grid: True
            y_grid: True
            xmin : 0 
            ymin : 0

        BoxLayout:
            orientation:'horizontal'
            size_hint: (1,0.1)
            BoxLayout:
                orientation:'horizontal'
                size_hint: (0.8,1)
                Label:
                    size_hint_x: 0.15
                    text: "Hora Início:"
                TextInput:
                    id: start_time_input
                    size_hint_x: 0.3
                    hint_text: "DD/MM/AAAA HH:MM:SS"
                    font_size: 14
                    halign:'center'
                    padding_y: (self.height - self.line_height) / 2
                    multiline: False
                Label:
                    size_hint_x: 0.15
                    text: "Hora Fim:"
                TextInput:
                    id: end_time_input
                    size_hint_x: 0.3
                    hint_text: "DD/MM/AAAA HH:MM:SS"
                    font_size: 14
                    halign:'center'
                    padding_y: (self.height - self.line_height) / 2
                    multiline: False
            Button:
                text: "Fechar"
                background_color: 1,0,0,1
                size_hint:(0.2,1)
                on_release: root.dismiss()                